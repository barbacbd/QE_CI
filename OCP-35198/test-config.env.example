# OCP-35198 Test Configuration
# Copy this file to test-config.env and fill in your values
# Usage: source test-config.env && ./test_ocp_35198_gcp_custom_types.sh

# Required: Your GCP Project ID
export GCP_PROJECT_ID="your-project-id-here"

# Optional: GCP Region and Zone
export GCP_REGION="us-west1"
export GCP_ZONE="us-west1-b"

# Optional: Cluster configuration
export BASE_DOMAIN="example.com"
export CLUSTER_NAME="test-cluster"

# Optional: Tool locations
export OPENSHIFT_INSTALL="openshift-install"
export PULL_SECRET_FILE="$HOME/.openshift/pull-secret.json"
export SSH_KEY="$HOME/.ssh/id_rsa.pub"

# Optional: Working directory
export WORK_DIR="/tmp/ocp-35198-test"

# Optional: OpenShift Installer Environment Variables
export OPENSHIFT_INSTALL_RELEASE_IMAGE_OVERRIDE="quay.io/openshift-release-dev/ocp-release:4.22.0-ec.5-x86_64"
export OPENSHIFT_INSTALL_EXPERIMENTAL_DISABLE_IMAGE_POLICY="true"
