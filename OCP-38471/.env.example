# OCP-38471 Test Environment Configuration
# Copy this file to .env and customize as needed

# Work Directory
# Where test runs will be created
WORK_DIR=/tmp/ocp-38471-test

# OpenShift Installer
# Path to openshift-install binary (or use system PATH)
OPENSHIFT_INSTALL=openshift-install

# OpenShift Release Image Override
# Use this to test against a specific OpenShift release
# Example: quay.io/openshift-release-dev/ocp-release:4.15.0-x86_64
OPENSHIFT_INSTALL_RELEASE_IMAGE_OVERRIDE=

# Experimental Features
# Disable image policy validation (useful for development/testing)
OPENSHIFT_INSTALL_EXPERIMENTAL_DISABLE_IMAGE_POLICY=false

# Credentials
# Path to your pull secret file
PULL_SECRET_FILE=$HOME/secrets/pull-secrets.txt

# Path to your SSH public key
SSH_KEY=$HOME/.ssh/github_ed25519.pub

# Cluster Configuration
# Base domain for the cluster
BASE_DOMAIN=installer.gcp.devcluster.openshift.com

# Cluster name
CLUSTER_NAME=bbarbach-ocp-38471

# Platform (aws, gcp, azure, vsphere, baremetal, etc.)
PLATFORM=gcp

# GCP Configuration (default platform)
GCP_PROJECT_ID=openshift-dev-installer
GCP_REGION=us-west1
GCP_ZONE=us-west1-b

# AWS Configuration (if using AWS)
# AWS_REGION=us-east-1

# Azure Configuration (if using Azure)
# AZURE_REGION=eastus
# AZURE_BASE_DOMAIN_RESOURCE_GROUP_NAME=os4-common

# Network Configuration for Test Cases
# These are used in the test install-config.yaml files
CLUSTER_NETWORK_CIDR=10.128.0.0/14
CLUSTER_NETWORK_HOST_PREFIX=23
MACHINE_NETWORK_CIDR=10.0.0.0/16
SERVICE_NETWORK_CIDR=172.30.0.0/16
NETWORK_TYPE=OVNKubernetes

# Test Execution Options
# Set to 'true' to keep test directories after execution
KEEP_TEST_DIRS=false

# Set to 'true' for verbose output
VERBOSE=false
